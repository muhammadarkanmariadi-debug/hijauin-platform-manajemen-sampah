# ==============================================================================
# Hijauin 2.0 — Production Secrets & Environment Template (.env.production.example)
# ==============================================================================
# Target EC2 Host: (Running alongside Mexpo & JHIC 2.0)
#
# Dedicated Host Port Allocations:
#   - Hijauin Frontend: 3002 (Mexpo: 3000, JHIC: 3001)
#   - Hijauin Backend:  5001 (Mexpo: 3500, JHIC: 5000)
#   - Hijauin Database: 5434 (Mexpo: 5432, JHIC: 5433)
#   - Hijauin Redis:    6380 (JHIC: 6379)
#
# HOW TO BULK IMPORT SECRETS TO GITHUB REPOSITORY SECRETS:
#
# 1. Copy this file to `.env.production` and fill in your actual values:
#      cp .env.production.example .env.production
# 2. Run the bulk secret importer:
#      node scripts/import-github-secrets.mjs
# ==============================================================================

# --- AWS & ECR Deployment Credentials ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
ECR_BACKEND_IMAGE=
ECR_FRONTEND_IMAGE=

# --- EC2 Instance Target ---
EC2_HOST=
EC2_USER=ubuntu
EC2_SSH_KEY=""

# --- Application Security & URLs ---
APP_NAME=Hijauin
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3002
SANCTUM_STATEFUL_DOMAINS=localhost:3002,127.0.0.1:3002

# --- PostgreSQL Database (Docker Container: hijauin_prod_db) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_HOST_PORT=5434
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=hijauin_backend

# --- Redis Cache & Queue (Docker Container: hijauin_prod_redis) ---
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_PASSWORD=

# --- AWS S3 Object Storage ---
FILESYSTEM_DISK=s3
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Frontend Client Environment (Public) ---
NEXT_PUBLIC_API_URL=http://localhost:5001/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Host Ports ---
BACKEND_PORT=5001
FRONTEND_PORT=3002
