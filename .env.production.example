# ==============================================================================
# Hijauin 2.0 — Production Secrets & Environment Template
# ==============================================================================
# Target EC2 Host: 172.31.15.223 (Running alongside Mexpo & JHIC 2.0)
#
# Dedicated Host Port Allocations:
#   - Hijauin Frontend: 3002 (Mexpo: 3000, JHIC: 3001)
#   - Hijauin Backend:  5001 (Mexpo: 3500, JHIC: 5000)
#   - Hijauin Database: 5434 (Mexpo: 5432, JHIC: 5433)
#   - Hijauin Redis:    6380 (JHIC: 6379)
#
# HOW TO BULK IMPORT SECRETS TO GITHUB REPOSITORY SECRETS:
#
# Option A (GitHub CLI - 1 Command Bulk Import):
#   1. Copy this file to `.env.production` and fill in your actual values:
#      cp .env.production.example .env.production
#   2. Run GitHub CLI bulk secret import:
#      gh secret set -f .env.production
#
# Option B (GitHub Web UI):
#   Go to GitHub Repo -> Settings -> Secrets and variables -> Actions -> New repository secret
# ==============================================================================

# --- AWS & ECR Deployment Credentials ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
ECR_BACKEND_IMAGE=331235584925.dkr.ecr.ap-southeast-2.amazonaws.com/hijauin-backend
ECR_FRONTEND_IMAGE=331235584925.dkr.ecr.ap-southeast-2.amazonaws.com/hijauin-frontend

# --- EC2 Instance Target ---
EC2_HOST=
EC2_USER=ubuntu
EC2_SSH_KEY=

# --- Application Security & URLs ---
APP_NAME=Hijauin
APP_ENV=production
APP_KEY=base64:qaWuRpZlHrjkG6GMgmuVTnQqvaqSw17fIINYp+aIKiE=
APP_DEBUG=false
APP_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3002
SANCTUM_STATEFUL_DOMAINS=localhost:3002,127.0.0.1:3002

# --- PostgreSQL Database (Docker Container: hijauin_prod_db) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_HOST_PORT=5434
DB_USER=postgres
DB_PASSWORD=010709Am
DB_DATABASE=hijauin_backend

# --- Redis Cache & Queue (Docker Container: hijauin_prod_redis) ---
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_PASSWORD=

# --- Cloudinary Storage Configuration ---
CLOUDINARY_CLOUD_NAME=hijauin-app
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --- Frontend Client Environment (Public) ---
NEXT_PUBLIC_API_URL=http://localhost:5001/api
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=hijauin-app
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=hijauin_preset
NEXT_PUBLIC_GOOGLE_CLIENT_ID=407408718192.apps.googleusercontent.com

# --- Host Ports ---
BACKEND_PORT=5001
FRONTEND_PORT=3002
